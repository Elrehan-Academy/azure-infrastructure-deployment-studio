{
  "$schema": "https://schema.management.azure.com/schemas/2021-09-09/uiFormDefinition.schema.json#",
  "view": {
    "kind": "Form",
    "properties": {
      "title": "Elrehan Azure Infrastructure Deployment Studio",
      "steps": [
        {
          "name": "basics",
          "label": "Basics",
          "description": "Configure the deployment target, subscription, resource group, primary region, and tags.",
          "elements": [
            {
              "name": "resourceScope",
              "type": "Microsoft.Common.ResourceScope",
              "subscription": {
                "resourceProviders": [
                  "Microsoft.Network",
                  "Microsoft.Compute"
                ]
              },
              "resourceGroup": {
                "allowExisting": true
              },
              "location": {
                "resourceTypes": [
                  "Microsoft.Resources/resourceGroups"
                ],
                "label": "Resource Group Region",
                "toolTip": "Select the Azure region where the resource group's metadata will be stored."
              }
            },
            {
              "name": "location",
              "type": "Microsoft.Common.LocationSelector",
              "label": "Infrastructure Deployment Region",
              "toolTip": "Select the Azure region where the infrastructure resources will be deployed. This can differ from the resource group region.",
              "resourceTypes": [
                "Microsoft.Network/virtualNetworks",
                "Microsoft.Compute/virtualMachines"
              ],
              "scope": {
                "subscriptionId": "[steps('basics').resourceScope.subscription.subscriptionId]"
              }
            },
            {
              "name": "tags",
              "type": "Microsoft.Common.TagsByResource",
              "label": "Resource Tags",
              "resources": [
                "Microsoft.Resources/deployments"
              ]
            },
            {
              "name": "costNotice",
              "type": "Microsoft.Common.InfoBox",
              "options": {
                "style": "Info",
                "text": "Cost Awareness: Network resources carry standard cloud charges. Virtual Machine deployment is optional and disabled by default (Pilot Safety Mode)."
              }
            }
          ]
        },
        {
          "name": "networking",
          "label": "Networking",
          "description": "Create a new Virtual Network with dynamic subnets, or deploy into an existing Virtual Network across resource groups.",
          "elements": [
            {
              "name": "vnetModeOptions",
              "type": "Microsoft.Common.OptionsGroup",
              "label": "Virtual Network Deployment Mode",
              "defaultValue": "new",
              "toolTip": "Select whether to provision a new Virtual Network or reference an existing Virtual Network.",
              "constraints": {
                "allowedValues": [
                  {
                    "label": "Create new virtual network",
                    "value": "new"
                  },
                  {
                    "label": "Use existing virtual network (same or cross-resource group)",
                    "value": "existing"
                  }
                ]
              }
            },
            {
              "name": "vnetName",
              "type": "Microsoft.Common.TextBox",
              "label": "Virtual Network Name",
              "defaultValue": "vnet-elrehan-pilot",
              "toolTip": "Name of the new Virtual Network (2-64 characters, alphanumeric and hyphens).",
              "constraints": {
                "required": true,
                "validations": [
                  {
                    "regex": "^[a-zA-Z0-9-_.]{2,64}$",
                    "message": "VNet name must be between 2 and 64 characters."
                  }
                ]
              },
              "visible": "[equals(steps('networking').vnetModeOptions, 'new')]"
            },
            {
              "name": "addressPrefix",
              "type": "Microsoft.Common.TextBox",
              "label": "VNet Address Space (IPv4 CIDR)",
              "defaultValue": "10.0.0.0/16",
              "toolTip": "The top-level IPv4 address prefix in CIDR notation (e.g. 10.0.0.0/16).",
              "constraints": {
                "required": true,
                "validations": [
                  {
                    "regex": "^(([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])(\\/([0-9]|[1-2][0-9]|3[0-2]))$",
                    "message": "Must be a valid IPv4 CIDR prefix."
                  }
                ]
              },
              "visible": "[equals(steps('networking').vnetModeOptions, 'new')]"
            },
            {
              "name": "subnetsGrid",
              "type": "Microsoft.Common.EditableGrid",
              "label": "Subnets Configuration",
              "ariaLabel": "Subnet configuration table",
              "constraints": {
                "width": "Full",
                "rows": {
                  "count": {
                    "min": 1,
                    "max": 10
                  }
                },
                "columns": [
                  {
                    "id": "name",
                    "header": "Subnet Name",
                    "width": "1fr",
                    "element": {
                      "type": "Microsoft.Common.TextBox",
                      "placeholder": "e.g. snet-workload",
                      "constraints": {
                        "required": true,
                        "validations": [
                          {
                            "regex": "^[a-zA-Z0-9-_.]{1,80}$",
                            "message": "Subnet name must be between 1 and 80 characters."
                          }
                        ]
                      }
                    }
                  },
                  {
                    "id": "addressPrefix",
                    "header": "Subnet CIDR Prefix",
                    "width": "1fr",
                    "element": {
                      "type": "Microsoft.Common.TextBox",
                      "placeholder": "e.g. 10.0.1.0/24",
                      "constraints": {
                        "required": true,
                        "validations": [
                          {
                            "regex": "^(([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])(\\/([0-9]|[1-2][0-9]|3[0-2]))$",
                            "message": "Must be a valid IPv4 CIDR prefix."
                          }
                        ]
                      }
                    }
                  }
                ]
              },
              "visible": "[equals(steps('networking').vnetModeOptions, 'new')]"
            },
            {
              "name": "existingVnetNotice",
              "type": "Microsoft.Common.InfoBox",
              "options": {
                "style": "Info",
                "text": "Targeting an existing VNet preserves all existing subnets, route tables, and peerings. Only Virtual Networks within the resource group selected in Basics are displayed."
              },
              "visible": "[equals(steps('networking').vnetModeOptions, 'existing')]"
            },
            {
              "name": "existingVnetsApi",
              "type": "Microsoft.Solutions.ArmApiControl",
              "request": {
                "method": "GET",
                "path": "[concat('/subscriptions/', steps('basics').resourceScope.subscription.subscriptionId, '/resourceGroups/', steps('basics').resourceScope.resourceGroup.name, '/providers/Microsoft.Network/virtualNetworks?api-version=2024-05-01')]"
              }
            },
            {
              "name": "noVnetsNotice",
              "type": "Microsoft.Common.InfoBox",
              "options": {
                "style": "Warning",
                "text": "No existing Virtual Networks were found in the selected resource group. Please switch to 'Create new virtual network' or select a resource group in Basics that contains virtual networks."
              },
              "visible": "[and(equals(steps('networking').vnetModeOptions, 'existing'), empty(steps('networking').existingVnetsApi.value))]"
            },
            {
              "name": "existingVnetDropDown",
              "type": "Microsoft.Common.DropDown",
              "label": "Existing Virtual Network",
              "placeholder": "Select an existing virtual network...",
              "toolTip": "Select an existing Virtual Network in the chosen resource group.",
              "filter": true,
              "constraints": {
                "allowedValues": "[map(steps('networking').existingVnetsApi.value, (item) => parse(concat('{\"label\":\"', item.name, ' (', item.location, ')\",\"value\":{\"id\":\"', item.id, '\",\"name\":\"', item.name, '\",\"location\":\"', item.location, '\"}}')))]",
                "required": true
              },
              "visible": "[equals(steps('networking').vnetModeOptions, 'existing')]"
            },
            {
              "name": "existingSubnetName",
              "type": "Microsoft.Common.TextBox",
              "label": "Target Existing Subnet Name",
              "toolTip": "Name of an existing subnet to bind VM or security controls to.",
              "constraints": {
                "required": false
              },
              "visible": "[equals(steps('networking').vnetModeOptions, 'existing')]"
            },
            {
              "name": "addNewSubnetToggle",
              "type": "Microsoft.Common.CheckBox",
              "label": "Deploy an additional subnet into this existing Virtual Network",
              "toolTip": "Adds a new child subnet to the existing VNet without disrupting existing subnets or peerings.",
              "visible": "[equals(steps('networking').vnetModeOptions, 'existing')]"
            },
            {
              "name": "newSubnetName",
              "type": "Microsoft.Common.TextBox",
              "label": "New Subnet Name",
              "defaultValue": "snet-workload-new",
              "constraints": {
                "required": false
              },
              "visible": "[and(equals(steps('networking').vnetModeOptions, 'existing'), steps('networking').addNewSubnetToggle)]"
            },
            {
              "name": "newSubnetPrefix",
              "type": "Microsoft.Common.TextBox",
              "label": "New Subnet CIDR Prefix",
              "defaultValue": "10.0.3.0/24",
              "constraints": {
                "required": false,
                "validations": [
                  {
                    "regex": "^(([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])(\\/([0-9]|[1-2][0-9]|3[0-2]))$",
                    "message": "Must be a valid IPv4 CIDR prefix."
                  }
                ]
              },
              "visible": "[and(equals(steps('networking').vnetModeOptions, 'existing'), steps('networking').addNewSubnetToggle)]"
            }
          ]
        },
        {
          "name": "security",
          "label": "Security",
          "description": "Configure Network Security Groups (NSG) and secure traffic policies.",
          "elements": [
            {
              "name": "securityIntro",
              "type": "Microsoft.Common.InfoBox",
              "options": {
                "style": "Info",
                "text": "Network Security Groups enforce strict zero-trust defaults: SSH and RDP are restricted to VirtualNetwork internal address spaces and never exposed directly to the public internet."
              }
            },
            {
              "name": "nsgModeOptions",
              "type": "Microsoft.Common.OptionsGroup",
              "label": "Network Security Group Option",
              "defaultValue": "new",
              "constraints": {
                "allowedValues": [
                  {
                    "label": "Create new NSG with enterprise secure defaults (Internal management only)",
                    "value": "new"
                  },
                  {
                    "label": "Associate existing NSG (same or cross-resource group)",
                    "value": "existing"
                  },
                  {
                    "label": "No NSG association (Unmanaged subnet security)",
                    "value": "none"
                  }
                ]
              }
            },
            {
              "name": "nsgName",
              "type": "Microsoft.Common.TextBox",
              "label": "New NSG Name",
              "defaultValue": "nsg-elrehan-pilot",
              "constraints": {
                "required": false
              },
              "visible": "[equals(steps('security').nsgModeOptions, 'new')]"
            },
            {
              "name": "existingNsgName",
              "type": "Microsoft.Common.TextBox",
              "label": "Existing NSG Name",
              "toolTip": "Name of the existing NSG to associate with the subnets.",
              "constraints": {
                "required": false
              },
              "visible": "[equals(steps('security').nsgModeOptions, 'existing')]"
            },
            {
              "name": "existingNsgResourceGroup",
              "type": "Microsoft.Common.TextBox",
              "label": "Existing NSG Resource Group (Optional for Cross-RG)",
              "toolTip": "Specify resource group name if the existing NSG is located in another resource group within this subscription.",
              "constraints": {
                "required": false
              },
              "visible": "[equals(steps('security').nsgModeOptions, 'existing')]"
            }
          ]
        },
        {
          "name": "routing",
          "label": "Routing",
          "description": "Configure Route Tables, custom next-hop routes, and BGP propagation.",
          "elements": [
            {
              "name": "routingIntro",
              "type": "Microsoft.Common.InfoBox",
              "options": {
                "style": "Info",
                "text": "Route tables govern packet forwarding for workloads. BGP propagation control allows fine-grained control when peering with ExpressRoute or VPN Gateways."
              }
            },
            {
              "name": "routeTableModeOptions",
              "type": "Microsoft.Common.OptionsGroup",
              "label": "Route Table Option",
              "defaultValue": "new",
              "constraints": {
                "allowedValues": [
                  {
                    "label": "Create new Route Table",
                    "value": "new"
                  },
                  {
                    "label": "Associate existing Route Table (same or cross-resource group)",
                    "value": "existing"
                  },
                  {
                    "label": "No Route Table association (Default system routing)",
                    "value": "none"
                  }
                ]
              }
            },
            {
              "name": "routeTableName",
              "type": "Microsoft.Common.TextBox",
              "label": "New Route Table Name",
              "defaultValue": "rt-elrehan-pilot",
              "constraints": {
                "required": false
              },
              "visible": "[equals(steps('routing').routeTableModeOptions, 'new')]"
            },
            {
              "name": "disableBgpRoutePropagation",
              "type": "Microsoft.Common.CheckBox",
              "label": "Disable BGP route propagation",
              "toolTip": "Check this box to prevent on-premises routes learned via BGP from propagating to this route table.",
              "visible": "[equals(steps('routing').routeTableModeOptions, 'new')]"
            },
            {
              "name": "existingRouteTableName",
              "type": "Microsoft.Common.TextBox",
              "label": "Existing Route Table Name",
              "toolTip": "Name of the existing Route Table to associate with the subnets.",
              "constraints": {
                "required": false
              },
              "visible": "[equals(steps('routing').routeTableModeOptions, 'existing')]"
            },
            {
              "name": "existingRouteTableResourceGroup",
              "type": "Microsoft.Common.TextBox",
              "label": "Existing Route Table Resource Group (Optional for Cross-RG)",
              "toolTip": "Specify resource group name if the existing Route Table is located in another resource group.",
              "constraints": {
                "required": false
              },
              "visible": "[equals(steps('routing').routeTableModeOptions, 'existing')]"
            }
          ]
        },
        {
          "name": "compute",
          "label": "Virtual Machines",
          "description": "Optionally provision a Virtual Machine for baseline validation.",
          "elements": [
            {
              "name": "deployVmToggle",
              "type": "Microsoft.Common.CheckBox",
              "label": "Enable Virtual Machine Resource Deployment",
              "toolTip": "Provision a pilot Virtual Machine attached to the selected subnet."
            },
            {
              "name": "osTypeOptions",
              "type": "Microsoft.Common.DropDown",
              "label": "Operating System",
              "defaultValue": "Linux",
              "toolTip": "Select Linux (Ubuntu 22.04 LTS) or Windows Server 2022 Datacenter.",
              "constraints": {
                "allowedValues": [
                  {
                    "label": "Linux (Ubuntu 22.04 LTS)",
                    "value": "Linux"
                  },
                  {
                    "label": "Windows (Windows Server 2022 Datacenter)",
                    "value": "Windows"
                  }
                ]
              },
              "visible": "[steps('compute').deployVmToggle]"
            },
            {
              "name": "vmName",
              "type": "Microsoft.Common.TextBox",
              "label": "Virtual Machine Name",
              "defaultValue": "vm-elrehan-pilot",
              "toolTip": "1-64 characters alphanumeric or hyphens.",
              "constraints": {
                "required": false,
                "validations": [
                  {
                    "regex": "^[a-zA-Z0-9-_.]{1,64}$",
                    "message": "VM name must be 1 to 64 alphanumeric characters, hyphens, or underscores."
                  }
                ]
              },
              "visible": "[steps('compute').deployVmToggle]"
            },
            {
              "name": "vmSizeLinux",
              "type": "Microsoft.Common.DropDown",
              "label": "Virtual Machine Size (Linux Recommended)",
              "defaultValue": "Standard_B2s",
              "toolTip": "Select an enterprise VM size recommended for pilot workloads.",
              "constraints": {
                "allowedValues": [
                  {
                    "label": "Standard_B2s (2 vCPUs, 4 GiB memory)",
                    "value": "Standard_B2s"
                  },
                  {
                    "label": "Standard_B2ms (2 vCPUs, 8 GiB memory)",
                    "value": "Standard_B2ms"
                  },
                  {
                    "label": "Standard_D2s_v5 (2 vCPUs, 8 GiB memory - General Purpose)",
                    "value": "Standard_D2s_v5"
                  },
                  {
                    "label": "Standard_D4s_v5 (4 vCPUs, 16 GiB memory - General Purpose)",
                    "value": "Standard_D4s_v5"
                  }
                ]
              },
              "visible": "[and(steps('compute').deployVmToggle, equals(steps('compute').osTypeOptions, 'Linux'))]"
            },
            {
              "name": "vmSizeWindows",
              "type": "Microsoft.Common.DropDown",
              "label": "Virtual Machine Size (Windows Recommended)",
              "defaultValue": "Standard_D2s_v5",
              "toolTip": "Select a VM size with at least 8 GiB RAM for Windows Server performance.",
              "constraints": {
                "allowedValues": [
                  {
                    "label": "Standard_D2s_v5 (2 vCPUs, 8 GiB memory - Recommended Windows Minimum)",
                    "value": "Standard_D2s_v5"
                  },
                  {
                    "label": "Standard_D4s_v5 (4 vCPUs, 16 GiB memory - General Purpose)",
                    "value": "Standard_D4s_v5"
                  },
                  {
                    "label": "Standard_B2ms (2 vCPUs, 8 GiB memory - Burstable)",
                    "value": "Standard_B2ms"
                  }
                ]
              },
              "visible": "[and(steps('compute').deployVmToggle, equals(steps('compute').osTypeOptions, 'Windows'))]"
            },
            {
              "name": "selectedSubnetName",
              "type": "Microsoft.Common.TextBox",
              "label": "Target Subnet Name for VM NIC",
              "defaultValue": "snet-workload",
              "toolTip": "Specify which subnet name the VM NIC will attach to.",
              "constraints": {
                "required": false
              },
              "visible": "[steps('compute').deployVmToggle]"
            },
            {
              "name": "adminUsername",
              "type": "Microsoft.Common.TextBox",
              "label": "Administrator Username",
              "defaultValue": "azureuser",
              "constraints": {
                "required": false,
                "validations": [
                  {
                    "regex": "^[a-zA-Z0-9-_.]{1,64}$",
                    "message": "Username must be 1 to 64 alphanumeric characters, hyphens, or underscores."
                  }
                ]
              },
              "visible": "[steps('compute').deployVmToggle]"
            },
            {
              "name": "adminSshPublicKey",
              "type": "Microsoft.Common.TextBox",
              "label": "SSH Public Key (Linux)",
              "toolTip": "OpenSSH public key (ssh-rsa or ssh-ed25519). ECDSA keys are rejected.",
              "constraints": {
                "required": false
              },
              "visible": "[and(steps('compute').deployVmToggle, equals(steps('compute').osTypeOptions, 'Linux'))]"
            },
            {
              "name": "adminPassword",
              "type": "Microsoft.Common.PasswordBox",
              "label": {
                "password": "Administrator Password (Windows)",
                "confirmPassword": "Confirm Password"
              },
              "toolTip": "Password between 12 and 123 characters with uppercase, lowercase, numbers, and special characters.",
              "constraints": {
                "required": false,
                "regex": "^(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])(?=.*[!@#$%^&*()-_=+]).{12,123}$",
                "validationMessage": "Password must be 12 to 123 characters and satisfy complexity requirements."
              },
              "visible": "[and(steps('compute').deployVmToggle, equals(steps('compute').osTypeOptions, 'Windows'))]"
            }
          ]
        },
        {
          "name": "review",
          "label": "Review",
          "description": "Inspect deployment parameters, architecture summary, and cost warnings prior to submission.",
          "elements": [
            {
              "name": "reviewSummary",
              "type": "Microsoft.Common.TextBlock",
              "options": {
                "text": "### Architecture & Deployment Summary\n\n- **Target Scope:** Resource Group deployment via native Form View.\n- **Networking:** Multi-tier Virtual Network (or targeted existing VNet with cross-RG support).\n- **Security:** Network Security Group with enterprise-grade internal-only management access.\n- **Routing:** Route Table with custom user-defined route capability.\n- **Compute:** Optional Virtual Machine (Pilot safety mode defaults to disabled).\n\nProceed to the next tab to execute the native Azure Resource Manager client validation."
              }
            },
            {
              "name": "securityNotice",
              "type": "Microsoft.Common.InfoBox",
              "options": {
                "style": "Warning",
                "text": "Zero Credential Exposure: Passwords and SSH private keys are never stored in template definitions or visible in portal reviews. Passwords remain masked at all times."
              }
            }
          ]
        }
      ]
    },
    "outputs": {
      "kind": "ResourceGroup",
      "resourceGroupId": "[steps('basics').resourceScope.resourceGroup.id]",
      "location": "[if(equals(steps('networking').vnetModeOptions, 'existing'), steps('networking').existingVnetDropDown.location, steps('basics').location.name)]",
      "parameters": {
        "location": "[if(equals(steps('networking').vnetModeOptions, 'existing'), steps('networking').existingVnetDropDown.location, steps('basics').location.name)]",
        "tags": "[steps('basics').tags]",
        "vnetMode": "[steps('networking').vnetModeOptions]",
        "vnetName": "[steps('networking').vnetName]",
        "addressPrefix": "[steps('networking').addressPrefix]",
        "subnets": "[steps('networking').subnetsGrid]",
        "existingVnetName": "[if(equals(steps('networking').vnetModeOptions, 'existing'), coalesce(steps('networking').existingVnetDropDown.name, ''), '')]",
        "existingVnetResourceGroup": "[if(equals(steps('networking').vnetModeOptions, 'existing'), steps('basics').resourceScope.resourceGroup.name, '')]",
        "existingSubnetName": "[steps('networking').existingSubnetName]",
        "addNewSubnet": "[steps('networking').addNewSubnetToggle]",
        "newSubnetName": "[steps('networking').newSubnetName]",
        "newSubnetPrefix": "[steps('networking').newSubnetPrefix]",
        "nsgMode": "[steps('security').nsgModeOptions]",
        "nsgName": "[steps('security').nsgName]",
        "existingNsgName": "[steps('security').existingNsgName]",
        "existingNsgResourceGroup": "[steps('security').existingNsgResourceGroup]",
        "routeTableMode": "[steps('routing').routeTableModeOptions]",
        "routeTableName": "[steps('routing').routeTableName]",
        "disableBgpRoutePropagation": "[steps('routing').disableBgpRoutePropagation]",
        "existingRouteTableName": "[steps('routing').existingRouteTableName]",
        "existingRouteTableResourceGroup": "[steps('routing').existingRouteTableResourceGroup]",
        "deployVm": "[steps('compute').deployVmToggle]",
        "osType": "[steps('compute').osTypeOptions]",
        "vmName": "[steps('compute').vmName]",
        "vmSize": "[if(equals(steps('compute').osTypeOptions, 'Linux'), steps('compute').vmSizeLinux, steps('compute').vmSizeWindows)]",
        "selectedSubnetName": "[steps('compute').selectedSubnetName]",
        "adminUsername": "[steps('compute').adminUsername]",
        "adminPassword": "[if(and(steps('compute').deployVmToggle, equals(steps('compute').osTypeOptions, 'Windows')), steps('compute').adminPassword, '')]",
        "adminSshPublicKey": "[if(and(steps('compute').deployVmToggle, equals(steps('compute').osTypeOptions, 'Linux')), steps('compute').adminSshPublicKey, '')]"
      }
    }
  }
}