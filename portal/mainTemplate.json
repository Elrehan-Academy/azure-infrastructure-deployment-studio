              "tags": "[parameters('tags')]",
              "properties": {
                "ipConfigurations": [
                  {
                    "name": "ipconfig1",
                    "properties": {
                      "subnet": {
                        "id": "[if(and(variables('authCheck'), variables('subnetCheck')), parameters('subnetId'), parameters('subnetId'))]"
