            ],
            "hasDuplicateSubnetNames": "[not(equals(length(union(variables('subnetNames'), createArray())), length(variables('subnetNames'))))]",
            "subnetNameCheck": "[if(variables('hasDuplicateSubnetNames'), fail('Duplicate subnet names detected in subnets array. Subnet names must be unique.'), true())]"
