    "isWindows": "[equals(parameters('osType'), 'Windows')]",
    "hasValidLinuxAuth": "[and(and(variables('isLinux'), not(empty(parameters('adminSshPublicKey')))), or(startsWith(parameters('adminSshPublicKey'), 'ssh-rsa'), startsWith(parameters('adminSshPublicKey'), 'ssh-ed25519')))]",
    "hasValidWindowsAuth": "[and(and(and(variables('isWindows'), not(empty(parameters('adminPassword')))), greaterOrEquals(length(parameters('adminPassword')), 12)), lessOrEquals(length(parameters('adminPassword')), 123))]",
    "hasValidAuth": "[or(variables('hasValidLinuxAuth'), variables('hasValidWindowsAuth'))]",
    "isSubnetValid": "[and(not(empty(parameters('selectedSubnetName'))), contains(variables('configuredSubnetNames'), parameters('selectedSubnetName')))]",
    "authCheck": "[if(parameters('deployVm'), if(not(variables('hasValidAuth')), fail('VM deployment is enabled, but valid authentication credentials were not provided. Linux requires an RSA (ssh-rsa) or ED25519 (ssh-ed25519) SSH public key; Windows requires a password between 12 and 123 characters satisfying complexity requirements.'), true()), true())]",
    "subnetCheck": "[if(parameters('deployVm'), if(not(variables('isSubnetValid')), fail(format('VM deployment is enabled, but the selected subnet \"{0}\" does not match any configured subnet in the subnets array.', parameters('selectedSubnetName'))), true()), true())]"
