                },
                "addressPrefix": {
                  "type": "string",
                  "metadata": {
                    "description": "IPv4 CIDR address prefix for the subnet."
                  }
                }
              },
              "metadata": {
                "description": "Subnet definition with name and addressPrefix."
              }
            }
          },
          "parameters": {
            "location": {
              "type": "string",
              "defaultValue": "[resourceGroup().location]",
