          "parameters": {
            "location": {
              "type": "string",
              "defaultValue": "[resourceGroup().location]",
              "metadata": {
                "description": "Azure region for compute resources."
              }
            },
            "vmName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "metadata": {
                "description": "Name of the Virtual Machine."
              }
            },
            "osType": {
              "type": "string",
              "defaultValue": "Linux",
              "allowedValues": [
                "Linux",
                "Windows"
              ],
              "metadata": {
                "description": "Operating System platform."
              }
            },
            "vmSize": {
              "type": "string",
              "defaultValue": "Standard_D2s_v5",
              "metadata": {
                "description": "The VM SKU size."
              }
            },
            "adminUsername": {
              "type": "string",
              "defaultValue": "azureuser",
              "minLength": 1,
              "maxLength": 64,
              "metadata": {
                "description": "Administrator username for the VM."
              }
            },
            "adminPassword": {
              "type": "securestring",
              "defaultValue": "",
              "metadata": {
                "description": "Administrator password for Windows VM. Required when osType is Windows."
              }
            },
            "adminSshPublicKey": {
              "type": "securestring",
              "defaultValue": "",
              "metadata": {
                "description": "SSH public key for Linux VM. Required when osType is Linux."
              }
            },
            "subnetId": {
              "type": "string",
              "metadata": {
                "description": "Subnet Resource ID where the VM NIC will be attached."
              }
            },
            "tags": {
              "type": "object",
              "defaultValue": {},
              "metadata": {
                "description": "Tags to apply to the VM and associated resources."
              }
            }
          },
          "variables": {
            "nicName": "[format('{0}-nic', parameters('vmName'))]",
            "isLinux": "[equals(parameters('osType'), 'Linux')]",
            "isWindows": "[equals(parameters('osType'), 'Windows')]",
            "hasValidLinuxAuth": "[and(and(variables('isLinux'), not(empty(parameters('adminSshPublicKey')))), or(startsWith(parameters('adminSshPublicKey'), 'ssh-rsa'), startsWith(parameters('adminSshPublicKey'), 'ssh-ed25519')))]",
            "hasValidWindowsAuth": "[and(and(and(variables('isWindows'), not(empty(parameters('adminPassword')))), greaterOrEquals(length(parameters('adminPassword')), 12)), lessOrEquals(length(parameters('adminPassword')), 123))]",
            "hasValidAuth": "[or(variables('hasValidLinuxAuth'), variables('hasValidWindowsAuth'))]",
            "authCheck": "[if(not(variables('hasValidAuth')), fail('VM authentication error: Linux requires an RSA (ssh-rsa) or ED25519 (ssh-ed25519) SSH public key; Windows requires a password between 12 and 123 characters satisfying complexity requirements.'), true())]",
            "subnetCheck": "[if(empty(parameters('subnetId')), fail('VM subnetId cannot be empty when provisioning compute resources.'), true())]"
